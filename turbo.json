{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "boundaries": {
    "tags": {
      "shared": { "dependencies": { "deny": ["domain-base", "domain-feature"] } },
      "domain-base": { "dependencies": { "deny": ["domain-feature"] } },
      "domain-feature": { "dependencies": { "deny": ["domain-feature"] } }
    }
  },
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^test"
      ]
    }
  }
}
